# ProofLens AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
#SECRET_KEY=change-this-in-production

# Email Configuration (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Google Custom Search API
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Winston AI (Image Detection)
WINSTON_AI_TOKEN=your-winston-ai-token

# Arya.ai Deepfake Detection APIs
ARYA_VIDEO_API_URL=https://ping.arya.ai/api/v1/deepfake-detection/video
ARYA_IMAGE_API_URL=https://ping.arya.ai/api/v1/deepfake-detection/image
